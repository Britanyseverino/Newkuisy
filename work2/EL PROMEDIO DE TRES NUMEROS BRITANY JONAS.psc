Algoritmo Calcular_el_promedio_de_3_números_BRITANY_JONAS
	Definir NUM1, NUM2, NUM3, Promedio Como Real
	Escribir "Este algoritmo calcula el promedio de tres numeros"
	Escribir " Ingresa el primer numero"
	Leer NUM1
	Escribir " Ingresa el segundo numero"
	Leer NUM2
	Escribir " Ingresa el tercer numero"
	Leer NUM3
	Promedio <-( NUM1 + NUM2 + NUM3 ) / 3
	Escribir "El Promedio de estos tres numero es: ", Promedio
FinAlgoritmo
